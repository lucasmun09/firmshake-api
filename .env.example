# Server — comma-separated browser origins (no trailing slashes).
# Local: localhost + Capacitor. Staging Cloud Run: see .cloudrun.env.yaml (includes
# firmshake-dev.web.app, firmshake-dev.firebaseapp.com, firm-shake.com, control panel).
# Prod Cloud Run: see .cloudrun.env.prod.yaml.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8100,capacitor://localhost,ionic://localhost
FLASK_DEBUG=true
PORT=5001

# Firebase Admin — required for meetup ETA updates
# Devo: firmshake-dev | Prod: firmshake-prod (see .cloudrun.env.prod.yaml)
FIREBASE_PROJECT_ID=firmshake-dev
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Cloud Storage — private bucket for listing images (Cloud Run service account needs access).
# Leave empty for local disk storage during development.
# Devo: firmshake-dev-images | Prod: firmshake-prod-images (separate bucket)
GCS_BUCKET=

# Meetup deposits / Stripe — default enabled when unset (devo).
# Prod Cloud Run must set PAYMENTS_ENABLED=false until live payments are ready.
# Alias: STRIPE_PAYMENTS_ENABLED (wins when set).
# PAYMENTS_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Image upload rate limit (per authenticated user)
IMAGE_UPLOAD_RATE_LIMIT=20
IMAGE_UPLOAD_RATE_WINDOW_SECONDS=3600

# reCAPTCHA v3 — server-side verification for login/register
# Classic keys: set RECAPTCHA_SECRET_KEY. GCP Enterprise keys: set RECAPTCHA_SITE_KEY instead.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=firmshake-dev
RECAPTCHA_MIN_SCORE=0.5

# Global API rate limits (in-memory per Cloud Run instance; not distributed)
API_RATE_LIMIT_IP=300
API_RATE_LIMIT_IP_WINDOW_SECONDS=60
API_RATE_LIMIT_UID=120
API_RATE_LIMIT_UID_WINDOW_SECONDS=60

# Optional ETA tuning
ETA_SPEED_MPH=25
ARRIVAL_RADIUS_METERS=100

# Typesense — primary browse search engine (POST /api/v1/browse/search).
# When unset, browse search falls back to Firestore queries.
# Use a SEPARATE Typesense cluster/database per stack (devo vs prod) — never share.
# TYPESENSE_HOST=https://your-typesense-host
# TYPESENSE_API_KEY=your-search-only-api-key
# TYPESENSE_LISTINGS_COLLECTION=listings

# Controlpanel — comma-separated emails with access before operators collection is seeded
# Devo only; leave empty on prod.
CONTROLPANEL_BOOTSTRAP_EMAILS=

# Default password for generated test accounts
TEST_ACCOUNT_DEFAULT_PASSWORD=FirmShakeTest123!
